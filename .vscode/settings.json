{
    "workbench.colorCustomizations": {
        "editor.background": "#1e1e1e",
        "sideBar.background": "#252526",
        "activityBar.background": "#333333",
        "titleBar.activeBackground": "#3c3c3c",
        "tab.activeBackground": "#1e1e1e",
        "tab.inactiveBackground": "#2d2d2d",
        "editorGroupHeader.tabsBackground": "#252526",
        "panel.background": "#1e1e1e",
        "statusBar.background": "#007acc"
    },
    "editor.tokenColorCustomizations": {
        "comments": "#808080",
        "textMateRules": [
            {
                "scope": ["comment", "comment.line", "comment.block"],
                "settings": {
                    "foreground": "#808080"
                }
            },
            {
                "scope": ["punctuation"],
                "settings": {
                    "foreground": "#ff8c00"
                }
            }
        ]
    },
    "locale": "zh-tw",
    "code-runner.executorMap": {
        "cpp": "cd $dir && g++ $fileName -o $fileNameWithoutExt.exe && $fileNameWithoutExt.exe && del $fileNameWithoutExt.exe",
        "c": "cd $dir ; if ($?) { gcc $fileName -o $fileNameWithoutExt } ; if ($?) { .\\$fileNameWithoutExt }",
        "java": "java -Dfile.encoding=UTF-8 $file",
        "python": "python -u",
        "javascript": "node",
        "typescript": "ts-node",
        "go": "go run"
    },
    "code-runner.runInTerminal": true,
    "code-runner.fileDirectoryAsCwd": true,
    "code-runner.preserveFocus": false,
    "code-runner.clearPreviousOutput": false,
    "code-runner.saveFileBeforeRun": true,
    "code-runner.saveAllFilesBeforeRun": true,
    "terminal.integrated.env.windows": {
        "GPP_PATH": "C:\\msys64\\ucrt64\\bin\\g++.exe"
    },
    "java.debug.settings.onBuildFailureProceed": true,
    "python-envs.defaultEnvManager": "ms-python.python:conda",
    "python-envs.defaultPackageManager": "ms-python.python:conda",
    "python-envs.pythonProjects": [],
    "claudeCodeChat.permissions.yoloMode": false
} 